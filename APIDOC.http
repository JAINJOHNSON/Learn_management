


# Register Admin

###
POST  http://127.0.0.1:8000/course/admin/register/
Content-Type: application/json

{
    "username":"admin1",
    "password":"admin1",
    "email":"admin1@gmail.com"
}

# ==============  USERS Created ========
#       admin1

# ======================================





# ============= COURSE create , list ==================

###
GET http://127.0.0.1:8000/course/courses/
Accept: application/json
Authorization: Basic admin1:admin1



###
POST http://127.0.0.1:8000/course/courses/
Content-Type: application/json
Authorization: Basic admin1:admin1

{
    "title": "Cyber Security",
    "description": "Learn Cyber Security Fundamentals",
    "duration": "4 months",
    "trainer": "Sanjay",
    "language": "Python",
    "price": 40000.00
}


# =============  COURSE retrive , Update , delete ===============================

###
GET http://127.0.0.1:8000/course/2/courses/
Accept: application/json
Authorization: Basic admin1:admin1




###
PUT http://127.0.0.1:8000/course/2/courses/
Content-Type: application/json
Authorization: Basic admin1:admin1

{
    "title": "Cyber Security",
    "description": "Learn Cyber Security Fundamentals",
    "duration": "4 months",
    "trainer": "Sanjay",
    "language": "Python",
    "price": 40000.00
}


###
DELETE  http://127.0.0.1:8000/course/2/courses/
Accept: application/json
Authorization: Basic admin1:admin1

